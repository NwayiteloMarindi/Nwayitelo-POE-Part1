@model List<EventViewModel>
@{ ViewData["Title"] = "Organiser Dashboard"; }

<section class="section-card">
    <div class="section-head">
        <div>
            <h2>Organiser Dashboard</h2>
            <p class="subtitle mb-0">Overview of your races, registrations, and results.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Event
        </a>
    </div>

    <div class="dashboard-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-calendar-event"></i></div>
            <div class="stat-content">
                <strong>@Model.Count</strong>
                <span>Total events</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div class="stat-content">
                <strong>@Model.Sum(e => e.Id > 0 ? 1 : 0)</strong>
                <span>Registrations</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-trophy"></i></div>
            <div class="stat-content">
                <strong>Live</strong>
                <span>Race status</span>
            </div>
        </div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>@ev.Title</td>
                            <td>@ev.Date.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td><span class="badge badge-primary">@ev.EventType</span></td>
                            <td>
                                <div class="dash-actions">
                                    <a asp-action="EventEnrolments" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-card-list"></i> Enrolments
                                    </a>
                                    <a asp-action="EventResults" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-bar-chart"></i> Results
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No events yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
