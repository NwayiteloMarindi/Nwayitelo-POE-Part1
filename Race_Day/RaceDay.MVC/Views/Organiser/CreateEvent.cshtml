@model CreateEventViewModel
@{ ViewData["Title"] = "Create Event"; }

<section class="form-shell">
    <div class="section-head">
        <div>
            <h2>Create Event</h2>
            <p class="subtitle mb-0">Publish a new race or event for participants.</p>
        </div>
    </div>

    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" class="card-surface">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label" for="Title">Title</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label" for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="Date">Date</label>
                <input asp-for="Date" type="date" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Location">Location</label>
                <input asp-for="Location" class="form-control" required />
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label class="form-label" for="Distance">Distance (km)</label>
                <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="EventType">Type</label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="BannerImage">Banner image</label>
                <input asp-for="BannerImage" type="file" accept="image/*" class="form-control" />
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label" for="CategoriesCsv">Categories</label>
            <input asp-for="CategoriesCsv" class="form-control" />
            <small class="form-text">Enter comma-separated categories, for example: Under 20, Senior, 10km, 21km</small>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create Event
            </button>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</section>
