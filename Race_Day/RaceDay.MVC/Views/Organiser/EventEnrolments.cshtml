@model List<EnrolmentViewModel>
@{ ViewData["Title"] = "Event Enrolments"; var eventId = (int)ViewBag.EventId; }

<section class="section-card">
    <div class="section-head">
        <div>
            <h2>Event Enrolments</h2>
            <p class="subtitle mb-0">Review participant registrations and confirm applications.</p>
        </div>
        <div class="dash-actions">
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
            <a asp-action="EventResults" asp-route-eventId="@eventId" class="btn btn-outline-primary">
                <i class="bi bi-bar-chart"></i> Results
            </a>
        </div>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge @(e.Status == "Confirmed" ? "badge-success" : "badge-warning")">@e.Status</span></td>
                            <td>
                                @if (e.Status == "Pending")
                                {
                                    <form asp-action="ConfirmEnrolment" method="post" class="d-inline">
                                        <input type="hidden" name="enrolmentId" value="@e.Id" />
                                        <input type="hidden" name="eventId" value="@eventId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check2-circle"></i> Confirm
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No enrolments yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
