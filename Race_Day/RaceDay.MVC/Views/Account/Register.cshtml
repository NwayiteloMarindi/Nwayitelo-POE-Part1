@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand justify-content-center mb-3">
                <span class="brand-mark"><i class="bi bi-flag-fill"></i></span>
                RaceDay
            </div>
            <h2>Create Account</h2>
            <p>Join the platform as a participant or organiser.</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label" for="Name">Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="Email">Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" required minlength="6" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="Role">Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="Participant">Participant</option>
                    <option value="Organiser">Organiser</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-person-plus"></i> Register
            </button>
        </form>

        <p class="form-text-link mb-0">
            Already have an account? <a asp-action="Login">Login</a>
        </p>
    </div>
</div>
