@model List<EventViewModel>
@{ ViewData["Title"] = "Events"; }

<section class="section-card">
    <div class="section-head">
        <div>
            <h2>Upcoming Events</h2>
            <p class="subtitle mb-0">Explore upcoming races and competitions.</p>
        </div>
    </div>

    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="eventType">Filter by type</label>
            <select name="eventType" class="form-select" id="eventType">
                <option value="">All Types</option>
                <option value="Run" selected="@(ViewBag.EventType == "Run")">Run</option>
                <option value="Walk" selected="@(ViewBag.EventType == "Walk")">Walk</option>
                <option value="Cycle" selected="@(ViewBag.EventType == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="event-grid">
            @foreach (var ev in Model)
            {
                <article class="event-card">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="card-image" alt="@ev.Title" />
                    }
                    <div class="card-body">
                        <span class="badge badge-primary mb-3">@ev.EventType</span>
                        <h3 class="card-title">@ev.Title</h3>
                        <p class="card-text">@ev.Description</p>

                        <div class="event-meta">
                            <i class="bi bi-calendar3"></i>
                            <span>@ev.Date.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="event-meta">
                            <i class="bi bi-geo-alt"></i>
                            <span>@ev.Location</span>
                        </div>
                        <div class="event-meta">
                            <i class="bi bi-clock-history"></i>
                            <span>@ev.Distance km · @ev.OrganiserName</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline-primary w-100">
                            <i class="bi bi-eye"></i> View Details
                        </a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state">No events found for the selected filter.</div>
    }
</section>
