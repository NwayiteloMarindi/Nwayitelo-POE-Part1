@model EventViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row g-4 align-items-start">
    <div class="col-lg-8">
        <div class="detail-card card-surface h-100">
            @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
            {
                <img src="@Model.BannerImageUrl" class="detail-image" alt="@Model.Title" />
            }
            <div class="detail-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge badge-primary">@Model.EventType</span>
                    <span class="badge badge-success">@Model.Distance km</span>
                </div>
                <h2>@Model.Title</h2>
                <p class="text-muted mb-4">@Model.Description</p>

                <ul class="meta-list">
                    <li><i class="bi bi-calendar3"></i> <span>@Model.Date.ToString("dddd, dd MMM yyyy")</span></li>
                    <li><i class="bi bi-geo-alt"></i> <span>@Model.Location</span></li>
                    <li><i class="bi bi-person-badge"></i> <span>@Model.OrganiserName</span></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="section-card h-100">
            <div class="section-head mb-3">
                <h3>Enrolment</h3>
            </div>

            @if (Model.Categories != null && Model.Categories.Any())
            {
                <form asp-action="Enrol" method="post">
                    <input type="hidden" name="eventId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Select category</label>
                        <select name="categoryId" class="form-select" required>
                            <option value="">Choose a category</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-check-circle"></i> Enrol Now
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info mb-0">No enrolment categories are available for this event yet.</div>
            }
        </div>
    </div>
</div>