@using Race_Day.Client.Models.DTOs;
@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<h1 class="display-6 mb-4">Dashboard</h1>

<!-- KPI row -->
<div class="row g-3 mb-4">
    <div class="col"><div class="card p-3 text-center"><h3>@Model.UserCount</h3><small>Users</small></div></div>
    <div class="col"><div class="card p-3 text-center"><h3>@Model.EventCount</h3><small>Events</small></div></div>
    <div class="col"><div class="card p-3 text-center"><h3>@Model.CategoryCount</h3><small>Categories</small></div></div>
    <div class="col"><div class="card p-3 text-center"><h3>@Model.EnrolmentCount</h3><small>Enrolments</small></div></div>
    <div class="col"><div class="card p-3 text-center"><h3>@Model.ResultCount</h3><small>Results</small></div></div>
</div>

<!-- Upcoming events -->
<h2 class="h5 mt-4">Upcoming Events</h2>
@if (Model.UpcomingEvents.Count == 0)
{
    <div class="alert alert-info">No upcoming events.</div>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var e in Model.UpcomingEvents)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@e.Race_EventName — @e.VenueId</span>
                <span>@e.Race_EventDate.ToString("dd MMM yyyy")</span>
            </li>
        }
    </ul>
}

<!-- Categories -->
<h2 class="h5 mt-4">Categories</h2>
<div class="card-container mb-4">
    @foreach (var c in Model.Categories)
    {
        <div class="card">
            <h3 class="card-title">@c.CategoryName</h3>
           <p>@c.CategoryDescription</p>
        </div>
    }
</div>

<!-- Recent enrolments -->
<h2 class="h5 mt-4">Recent Enrolments</h2>
@if (Model.RecentEnrolments.Count == 0)
{
    <div class="alert alert-info">No enrolments yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>User</th><th>Event</th><th>Category</th><th>Status</th><th>Paid</th><th>Date</th></tr></thead>
        <tbody>
            @foreach (var e in Model.RecentEnrolments)
            {
                <tr>
                    <td>@e.ParticipantName</td>
                    <td>@e.ParticipantAddress</td>
                    <td>@e.ParticipantCity</td>
                    <td>@e.ParticipantProvince</td>
                   
                    <td>@e.Race_EventId</td>
                </tr>
            }
        </tbody>
    </table>
}