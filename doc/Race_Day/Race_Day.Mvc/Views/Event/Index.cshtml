@model Race_Day.Client.Models.DTOs.DashboardDto

@{
    ViewData["Title"] = "Events";
    Layout = "_Layout";
}


<div class="container-fluid events-page">

    <div class="page-heading">
        <div>
            <h2>Marathon Events</h2>
            <p>Explore all races and track upcoming events.</p>
        </div>
    </div>

    <!-- Statistics -->
    <div class="event-stats">
        <div class="stat-card featured">
            <span>Total Events</span>
            <h3>@Model.AllEvents.Count</h3>
        </div>

        <div class="stat-card">
            <span>Upcoming Events</span>
            <h3>@Model.UpcomingEvents.Count</h3>
        </div>

        <div class="stat-card">
            <span>Ended Events</span>
            <h3>@Model.EndedEvents.Count</h3>
        </div>
    </div>

    <!-- All Events -->
    <section class="event-section">
        <div class="section-heading">
            <h4>All Events</h4>
            <span class="count-badge">@Model.AllEvents.Count events</span>
        </div>

        @if (Model.AllEvents.Any())
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Venue ID</th>
                            <th>Description</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AllEvents)
                        {
                            <tr>
                                <td class="event-name">@item.Race_EventName</td>
                                <td>@item.Race_EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.VenueId</td>
                                <td>@item.Description</td>
                                <td>
                                    <span class="status status-upcoming">
                                        @item.Race_EventStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h5>No events found</h5>
                <p>Events will appear here when they become available.</p>
            </div>
        }
    </section>

    <!-- Upcoming Events -->
    <section class="event-section">
        <div class="section-heading">
            <h4>Upcoming Events</h4>
            <span class="count-badge">@Model.UpcomingEvents.Count events</span>
        </div>

        @if (Model.UpcomingEvents.Any())
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Venue ID</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UpcomingEvents)
                        {
                            <tr>
                                <td class="event-name">@item.Race_EventName</td>
                                <td>@item.Race_EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.VenueId</td>
                                <td>@item.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h5>No upcoming events</h5>
                <p>Check again later for future races.</p>
            </div>
        }
    </section>

    <!-- Ended Events -->
    <section class="event-section">
        <div class="section-heading">
            <h4>Ended Events</h4>
            <span class="count-badge">@Model.EndedEvents.Count events</span>
        </div>

        @if (Model.EndedEvents.Any())
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Venue ID</th>
                            <th>Description</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.EndedEvents)
                        {
                            <tr>
                                <td class="event-name">@item.Race_EventName</td>
                                <td>@item.Race_EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.VenueId</td>
                                <td>@item.Description</td>
                                <td>
                                    <span class="status status-ended">
                                        @item.Race_EventStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h5>No ended events</h5>
                <p>Completed events will appear here.</p>
            </div>
        }
    </section>

</div>